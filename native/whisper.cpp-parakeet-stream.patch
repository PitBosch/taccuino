@@ -0,0 +1,74 @@
+// Libreria minima per Taccuino: Parakeet (whisper.cpp) chiamabile da Python con ctypes.
+// Tre funzioni C, niente struct da passare: tq_open, tq_transcribe, tq_close.
+#include "parakeet.h"
+
+#include <cstdlib>
+#include <cstring>
+#include <string>
+
+#if defined(_WIN32)
+#define TQ_API extern "C" __declspec(dllexport)
+#else
+#define TQ_API extern "C" __attribute__((visibility("default")))
+#endif
+
+struct tq_ctx {
+    parakeet_context * ctx = nullptr;
+    int n_threads = 4;
+    std::string text;
+};
+
+static void tq_quiet(enum ggml_log_level level, const char * msg, void *) {
+    if (level >= GGML_LOG_LEVEL_WARN && getenv("TQ_ASR_QUIET") == nullptr) {
+        fputs(msg, stderr);
+    }
+}
+
+// stream=1: pesi dell'encoder letti dal disco strato per strato (pochi MB in RAM)
+TQ_API void * tq_open(const char * model_path, int n_threads, int stream) {
+#if defined(_WIN32)
+    _putenv_s("PARAKEET_STREAM", stream ? "1" : "0");
+#else
+    setenv("PARAKEET_STREAM", stream ? "1" : "0", 1);
+#endif
+    if (getenv("TQ_ASR_VERBOSE") == nullptr) {
+        parakeet_log_set(tq_quiet, nullptr);
+    }
+    parakeet_context_params cp = parakeet_context_default_params();
+    cp.use_gpu = false;
+    parakeet_context * ctx = parakeet_init_from_file_with_params(model_path, cp);
+    if (!ctx) {
+        return nullptr;
+    }
+    auto * t = new tq_ctx();
+    t->ctx = ctx;
+    t->n_threads = n_threads > 0 ? n_threads : 4;
+    return t;
+}
+
+// audio mono 16 kHz float32; il testo resta valido fino alla chiamata successiva
+TQ_API const char * tq_transcribe(void * handle, const float * samples, int n_samples) {
+    auto * t = (tq_ctx *) handle;
+    if (!t || !samples || n_samples <= 0) {
+        return "";
+    }
+    parakeet_full_params fp = parakeet_full_default_params(PARAKEET_SAMPLING_GREEDY);
+    fp.n_threads = t->n_threads;
+    if (parakeet_full(t->ctx, fp, samples, n_samples) != 0) {
+        return nullptr;
+    }
+    t->text.clear();
+    const int n = parakeet_full_n_segments(t->ctx);
+    for (int i = 0; i < n; ++i) {
+        t->text += parakeet_full_get_segment_text(t->ctx, i);
+    }
+    return t->text.c_str();
+}
+
+TQ_API void tq_close(void * handle) {
+    auto * t = (tq_ctx *) handle;
+    if (t) {
+        parakeet_free(t->ctx);
+        delete t;
+    }
+}

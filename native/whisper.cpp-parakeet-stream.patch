+// accesso al file del modello per lo streaming: lettura a una posizione data, senza seek condiviso
+struct parakeet_stream_file {
+#if defined(_WIN32)
+    HANDLE h = INVALID_HANDLE_VALUE;
+
+    bool open(const std::string & path) {
+        int n = MultiByteToWideChar(CP_UTF8, 0, path.c_str(), -1, nullptr, 0);
+        std::wstring w(n > 0 ? n : 1, L'\0');
+        MultiByteToWideChar(CP_UTF8, 0, path.c_str(), -1, &w[0], n);
+        // SEQUENTIAL_SCAN: la cache di Windows libera prima queste pagine (e resta comunque memoria disponibile)
+        h = CreateFileW(w.c_str(), GENERIC_READ, FILE_SHARE_READ, nullptr, OPEN_EXISTING,
+                        FILE_ATTRIBUTE_NORMAL | FILE_FLAG_SEQUENTIAL_SCAN, nullptr);
+        return h != INVALID_HANDLE_VALUE;
+    }
+    long long read_at(void * dst, size_t n, size_t off) {
+        OVERLAPPED ov = {};
+        ov.Offset     = (DWORD) (off & 0xFFFFFFFFull);
+        ov.OffsetHigh = (DWORD) ((unsigned long long) off >> 32);
+        DWORD got = 0;
+        const DWORD want = (DWORD) std::min<size_t>(n, 1u << 30);
+        if (!ReadFile(h, dst, want, &got, &ov)) {
+            return -1;
+        }
+        return (long long) got;
+    }
+    void drop(size_t, size_t) {} // Windows non ha un equivalente per intervallo
+    void close() {
+        if (h != INVALID_HANDLE_VALUE) {
+            CloseHandle(h);
+            h = INVALID_HANDLE_VALUE;
+        }
+    }
+#else
+    int fd = -1;
+
+    bool open(const std::string & path) {
+        fd = ::open(path.c_str(), O_RDONLY);
+        return fd >= 0;
+    }
+    long long read_at(void * dst, size_t n, size_t off) {
+        return (long long) pread(fd, dst, n, (off_t) off);
+    }
+    void drop(size_t off, size_t n) {
+#if defined(POSIX_FADV_DONTNEED)
+        posix_fadvise(fd, (off_t) off, (off_t) n, POSIX_FADV_DONTNEED); // via dalla page cache
+#else
+        (void) off; (void) n;
+#endif
+    }
+    void close() {
+        if (fd >= 0) {
+            ::close(fd);
+            fd = -1;
+        }
+    }
+#endif
+};
+
+// ---------------------------------------------------------------------------
+// Streaming dei pesi dell'encoder strato per strato (esperimento, attivato con PARAKEET_STREAM=1).
+//
+// Le grandi matrici di ogni strato conformer NON restano in RAM: ci sono due "slot" grandi
+// quanto uno strato. Mentre la CPU calcola lo strato i (slot i%2), un thread legge dal file lo
+// strato i+1 nell'altro slot; a fine strato i lo slot si libera e parte la lettura di i+2.
+// Dopo ogni lettura si chiede al kernel di non tenere quei dati in cache (POSIX_FADV_DONTNEED),
+// così i pesi non occupano RAM nemmeno come page cache.
+// I tensori piccoli dello strato (norme, bias, conv depthwise, batch norm, attn_pos_w) restano
+// in RAM: alcuni sono usati da operazioni che non dipendono dall'attivazione e il grafo
+// potrebbe eseguirle prima che lo strato sia stato letto.
+// ---------------------------------------------------------------------------
+struct parakeet_stream_rec {
+    struct ggml_tensor * t = nullptr;
+    size_t off    = 0; // posizione nel file
+    size_t nbytes = 0;
+};
+
+struct parakeet_stream {
+    bool enabled = false;
+    parakeet_stream_file file;
+    bool drop_cache = true;
+    int  n_layer = 0;
+
+    ggml_context * ctx = nullptr;                          // metadati dei tensori in streaming
+    std::vector<std::vector<parakeet_stream_rec>> layers;  // per strato
+    std::map<const ggml_tensor *, std::pair<int, int>> index; // tensore -> (strato, posizione)
+
+    ggml_backend_buffer_t slot[2] = { nullptr, nullptr };
+    int in_slot[2] = { -1, -1 };                           // quale strato è caricato in ogni slot
+    std::thread th;
+    std::vector<char> tmp;                                 // buffer di lettura (solo per slot con repack)
+    ggml_backend_buffer_type_t buft = nullptr;             // tipo di buffer scelto per le matrici
+
+    int64_t t_io_us   = 0; // tempo passato a leggere (nel thread di lettura)
+    int64_t t_wait_us = 0; // tempo in cui il calcolo ha aspettato la lettura
+    size_t  bytes_read = 0;
+
+    void load_layer(int il) {
+        const int64_t t0 = ggml_time_us();
+        for (auto & r : layers[il]) {
+            const bool direct = ggml_backend_buffer_is_host(r.t->buffer);
+            if (!direct) {
+                tmp.resize(r.nbytes);
+            }
+            char * dst = direct ? (char *) r.t->data : tmp.data();
+            size_t done = 0;
+            while (done < r.nbytes) {
+                long long n = file.read_at(dst + done, r.nbytes - done, r.off + done);
+                if (n <= 0) {
+                    fprintf(stderr, "parakeet_stream: lettura fallita (strato %d)\n", il);
+                    abort();
+                }
+                done += (size_t) n;
+            }
+            if (!direct) {
+                ggml_backend_tensor_set(r.t, tmp.data(), 0, r.nbytes); // repack per la CPU
+            }
+            if (drop_cache) {
+                file.drop(r.off, r.nbytes);
+            }
+            bytes_read += r.nbytes;
+        }
+        in_slot[il % 2] = il;
+        t_io_us += ggml_time_us() - t0;
+    }
+
+    void start(int il) {
+        if (il >= n_layer || in_slot[il % 2] == il) {
+            return;
+        }
+        th = std::thread([this, il]() { load_layer(il); });
+    }
+
+    void wait() {
+        if (th.joinable()) {
+            const int64_t t0 = ggml_time_us();
+            th.join();
+            t_wait_us += ggml_time_us() - t0;
+        }
+    }
+
+    // prima di calcolare l'encoder: strato 0 pronto, strato 1 in arrivo
+    void begin() {
+        wait();
+        if (in_slot[0] != 0) {
+            const int64_t t0 = ggml_time_us();
+            load_layer(0);
+            t_wait_us += ggml_time_us() - t0;
+        }
+        start(1);
+    }
+
+    ~parakeet_stream() {
+        if (th.joinable()) {
+            th.join();
+        }
+        file.close();
+        for (auto & b : slot) {
+            if (b) {
+                ggml_backend_buffer_free(b);
+            }
+        }
+        if (ctx) {
+            ggml_free(ctx);
+        }
+    }
+};
+
+// impostati da parakeet_init_from_file_* prima del caricamento (lo streaming richiede un file)
+static std::string     g_stream_path;
+static std::ifstream * g_stream_fin = nullptr;
+
+// callback del grafo. L'uscita dello strato i-1 viene rinominata "enc_<i>_res" all'inizio dello strato i:
+// quando quel nodo è calcolato lo strato i-1 è finito, il suo slot è libero e lì si carica lo strato i+1.
+static bool parakeet_stream_eval_cb(struct ggml_tensor * t, bool ask, void * user_data) {
+    int il = -1;
+    char tail[8] = { 0 };
+    const bool hit = sscanf(ggml_get_name(t), "enc_%d_%7s", &il, tail) == 2 && strcmp(tail, "res") == 0 && il >= 1;
+    if (ask) {
+        return hit;
+    }
+    if (hit) {
+        auto * st = (parakeet_stream *) user_data;
+        st->wait();         // lo strato il deve essere pronto prima di calcolarlo
+        st->start(il + 1);  // nello slot dello strato il-1, appena finito
+    }
+    return true;
+}
